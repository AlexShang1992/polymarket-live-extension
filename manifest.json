{
  "manifest_version": 3,
  "name": "BTC 5分钟 · 本机行情对照",
  "version": "1.3.7",
  "description": "显示本机 BTC 曲线，并将最近60秒 BTC 与最近60秒 Up/Down 盘口叠加对照。只读，不连接钱包。",
  "minimum_chrome_version": "114",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "content_scripts": [{
    "matches": ["https://polymarket.com/*", "https://www.polymarket.com/*"],
    "js": ["chart.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_title": "BTC 本机行情对照", "default_popup": "popup.html"}
}
